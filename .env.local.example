# Supabase project settings (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT secret for signing session tokens (keep this secret)
JWT_SECRET=replace_with_a_strong_random_value

# Dedicated membership QR signing secret (at least 32 random bytes; never reuse JWT_SECRET)
MEMBERSHIP_QR_SECRET=

# Canonical deployed application origin; omit locally to use the request origin
APP_URL=

# Temporary development/demo SMTP (server-side only; never NEXT_PUBLIC_*)
# Never commit real credentials; use .env.local or deployment environment variables.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itpteam17@gmail.com
# Gmail app password 
SMTP_PASSWORD=
EMAIL_FROM=itpteam17@gmail.com

# Production option: Resend transactional email provider.
# Temporarily disabled for ITP2 development/demo.
# EMAIL_API_KEY=

# Independent random secrets, at least 32 characters each
EMAIL_CHANGE_SECRET=
EMAIL_NOTIFICATION_CRON_SECRET=
